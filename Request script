    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    
    local state = Get(key, default)
    
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(0.6, 0, 1, 0)
    lb.Position = UDim2.new(0, 10, 0, 0)
