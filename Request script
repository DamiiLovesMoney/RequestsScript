-- AUTO DECLINE CODE
-- ============================================
local autoDeclineConnections = {}
local declineStats = {
    requests = 0,
    carries = 0,
    guis = 0,
    prompts = 0
}

local function GetDeclineStats()
    return declineStats
end

local function ResetDeclineStats()
    declineStats = {requests = 0, carries = 0, guis = 0, prompts = 0}
end

local function StartAutoDecline()
    if autoDeclineConnections.declineRequest then
        autoDeclineConnections.declineRequest:Disconnect()
    end
    
    if autoDeclineConnections.carryStarted then
        autoDeclineConnections.carryStarted:Disconnect()
    end
    
    if autoDeclineConnections.sendRequestGui then
        autoDeclineConnections.sendRequestGui:Disconnect()
    end
    
    if autoDeclineConnections.togglePrompts then
        autoDeclineConnections.togglePrompts:Disconnect()
    end
    
    if autoDeclineConnections.spamLoop then
        autoDeclineConnections.spamLoop:Disconnect()
    end
    
    ResetDeclineStats()
    
    autoDeclineConnections.declineRequest = player.ChildAdded:Connect(function(child)
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local childName = string.lower(child.Name)
            if childName:find("request") or childName:find("invite") or childName:find("accept") then
                for i = 1, 4 do
                    pcall(function()
                        DeclineRequest:FireServer()
                    end)
                end
                declineStats.requests = declineStats.requests + 1
            end
        end
    end)
    
    autoDeclineConnections.carryStarted = CarryStarted.OnClientEvent:Connect(function(requester)
        local whiteListStr = Get("DeclineWhitelist", "")
        local whiteList = parseList(whiteListStr)
        
        local shouldDecline = true
        if #whiteList > 0 and requester then
            if isTarget(requester.Name, whiteList) or isTarget(requester.DisplayName, whiteList) then
                shouldDecline = false
            end
        end
        
        if shouldDecline then
            for i = 1, 5 do
                pcall(function()
                    StopCarry:FireServer()
                    DeclineRequest:FireServer()
                end)
            end
            declineStats.carries = declineStats.carries + 1
        end
    end)
    
    autoDeclineConnections.sendRequestGui = SendRequestGui.OnClientEvent:Connect(function(requester)
        local whiteListStr = Get("DeclineWhitelist", "")
        local whiteList = parseList(whiteListStr)
        
        local shouldDecline = true
        if #whiteList > 0 and requester then
            if isTarget(requester.Name, whiteList) or isTarget(requester.DisplayName, whiteList) then
                shouldDecline = false
            end
        end
        
        if shouldDecline then
            for i = 1, 5 do
                pcall(function()
                    DeclineRequest:FireServer()
                    StopCarry:FireServer()
                end)
            end
            declineStats.guis = declineStats.guis + 1
        end
    end)
    
    autoDeclineConnections.togglePrompts = TogglePrompts.OnClientEvent:Connect(function(...)
        for i = 1, 5 do
            pcall(function()
                TogglePrompts:FireServer(false)
            end)
        end
        declineStats.prompts = declineStats.prompts + 1
    end)
    
    autoDeclineConnections.spamLoop = RunService.Heartbeat:Connect(function()
        if Get("AutoDecline", false) then
            for i = 1, 5 do
                pcall(function()
                    DeclineRequest:FireServer()
                    StopCarry:FireServer()
                    TogglePrompts:FireServer(false)
                end)
            end
        end
    end)
end

local function StopAutoDecline()
    for k, v in pairs(autoDeclineConnections) do
        if v then v:Disconnect() end
    end
    autoDeclineConnections = {}
    ResetDeclineStats()
end

-- ============================================
-- AUTO SEND & ACCEPT CARRY REQUESTS CODE
-- ============================================
local autoSendAcceptConnections = {}

local function StartAutoSendAccept()
    if autoSendAcceptConnections.megaSpamLoop then
        autoSendAcceptConnections.megaSpamLoop:Disconnect()
    end
    
    if autoSendAcceptConnections.acceptIncoming then
        autoSendAcceptConnections.acceptIncoming:Disconnect()
    end
    
    autoSendAcceptConnections.acceptIncoming = SendRequestGui.OnClientEvent:Connect(function(requester)
        if requester and requester ~= player then
            local acceptListStr = Get("AutoAcceptWhitelist", "")
            local blacklistStr = Get("AutoAcceptBlacklist", "")
            local acceptList = parseList(acceptListStr)
            local blacklist = parseList(blacklistStr)
            
            -- Check if player is blacklisted
            if isSafe(requester.Name, blacklist) or isSafe(requester.DisplayName, blacklist) then
                return
            end
            
            local shouldAccept = false
            if #acceptList == 0 then
                shouldAccept = true
            else
                if isTarget(requester.Name, acceptList) or isTarget(requester.DisplayName, acceptList) then
                    shouldAccept = true
                end
            end
            
            if shouldAccept then
                for i = 0, 1 do
                    pcall(function()
                        CarryRequest:FireServer(requester, 1, 0, 1, 0, 180, 0)
                    end)
                end
            end
        end
    end)
    
    autoSendAcceptConnections.megaSpamLoop = RunService.Heartbeat:Connect(function()
        if Get("AutoAcceptRequests", false) then
            local acceptListStr = Get("AutoAcceptWhitelist", "")
            local blacklistStr = Get("AutoAcceptBlacklist", "")
            local acceptList = parseList(acceptListStr)
            local blacklist = parseList(blacklistStr)
            
            for _, p in Players:GetPlayers() do
                if p ~= player then
                    -- Check if player is blacklisted
                    if isSafe(p.Name, blacklist) or isSafe(p.DisplayName, blacklist) then
                        continue
                    end
                    
                    local shouldSend = false
                    if #acceptList == 0 then
                        shouldSend = true
                    else
                        if isTarget(p.Name, acceptList) or isTarget(p.DisplayName, acceptList) then
                            shouldSend = true
                        end
                    end
                    
                    if shouldSend then
                        for i = 0, 1 do
                            pcall(function()
                                CarryRequest:FireServer(p, 1, 0, 1, 0, 180, 0)
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function StopAutoSendAccept()
    for k, v in pairs(autoSendAcceptConnections) do
        if v then v:Disconnect() end
    end
    autoSendAcceptConnections = {}
end

local function StartAutoDeclineRequests()
    if autoSendAcceptConnections.declineLoop then
        autoSendAcceptConnections.declineLoop:Disconnect()
    end
    
    autoSendAcceptConnections.declineLoop = RunService.Heartbeat:Connect(function()
        if Get("AutoDeclineRequests", false) then
            pcall(function()
                DeclineRequest:FireServer()
                StopCarry:FireServer()
            end)
        end
    end)
end

local function StopAutoDeclineRequests()
    if autoSendAcceptConnections.declineLoop then
        autoSendAcceptConnections.declineLoop:Disconnect()
        autoSendAcceptConnections.declineLoop = nil
    end
end

-- ============================================
-- SPAM CARRY REQUEST CODE
-- ============================================
local spamCarryConnections = {}

local function StartSpamCarry()
    if spamCarryConnections.spamLoop then
        spamCarryConnections.spamLoop:Disconnect()
    end
    
    spamCarryConnections.spamLoop = RunService.Heartbeat:Connect(function()
        if Get("SpamCarry", false) then
            local targetName = Get("SpamCarryTarget", "")
            if targetName == "" then return end
            
            local targetPlayer = Players:FindFirstChild(targetName)
            if not targetPlayer then return end
            
            for i = 0, 1 do
                pcall(function()
                    CarryRequest:FireServer(targetPlayer, 1, 0, 1, 0, 180, 0)
                end)
            end
        end
    end)
end

local function StopSpamCarry()
    if spamCarryConnections.spamLoop then
        spamCarryConnections.spamLoop:Disconnect()
        spamCarryConnections.spamLoop = nil
    end
end

